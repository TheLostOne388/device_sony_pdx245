cc_binary {
    name: "lptodm",
    recovery: true,
    srcs: ["lptodm.cpp"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    include_dirs: [
        "system/core/fs_mgr/liblp/include",
        "system/libbase/include",
    ],
    whole_static_libs: [
        "liblp",
    ],
    static_libs: [
        "libfs_mgr",
        "libgsi",
        "libdm",
        "libcrypto_utils",
        "libsparse",
        "libext4_utils",
        "libz",
        "libcutils",
        "libselinux",
        "libkeyutils",
    ],
    shared_libs: [
        "libcrypto",
        "libbase",
        "liblog",
    ],
}
