# Minimal fstab for recovery.
# This fstab is intentionally simple. Its only job is to inform fs_mgr
# that logical partitions exist so that device-mapper can create them.
# It does not perform AVB checks or complex mounts, as that is not
# recovery's responsibility.

#<src>          <mnt_point>     <type>  <mnt_flags and options> <fs_mgr_flags>
system          /system         ext4    ro,barrier=1            wait,slotselect,logical
system_ext      /system_ext     ext4    ro,barrier=1            wait,slotselect,logical
product         /product        ext4    ro,barrier=1            wait,slotselect,logical
vendor          /vendor         erofs   ro                      wait,slotselect,logical
vendor_dlkm     /vendor_dlkm    erofs   ro                      wait,slotselect,logical
system_dlkm     /system_dlkm    ext4    ro,barrier=1            wait,slotselect,logical
odm             /odm            erofs   ro                      wait,slotselect,logical

# Standard partitions required for recovery operation.
/dev/block/by-name/metadata      /metadata       f2fs    noatime,nosuid,nodev,discard      wait,check,formattable
/dev/block/bootdevice/by-name/userdata  /data    f2fs    noatime,nosuid,nodev,discard      latemount,wait,check,formattable
/dev/block/bootdevice/by-name/misc      /misc           emmc    defaults                  defaults 
