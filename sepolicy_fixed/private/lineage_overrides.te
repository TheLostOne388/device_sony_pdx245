# Lineage overrides for problematic policies
# These neverallow rules are causing issues with system_ext sepolicy

# Override LiveDisplay property access
dontaudit hal_lineage_livedisplay_qti {
  property_type
  vendor_display_prop
}:file { getattr open read map };

dontaudit hal_lineage_livedisplay_sysfs {
  property_type
  vendor_display_prop
}:file { getattr open read map };
