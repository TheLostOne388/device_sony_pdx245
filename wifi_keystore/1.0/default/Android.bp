cc_binary {
    name: "android.system.wifi.keystore@1.0-service",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    proprietary: true,
    srcs: ["service.cpp"],
    shared_libs: [
        "libhidlbase",
        "libutils",
        "android.system.wifi.keystore@1.0",
    ],
    init_rc: ["android.system.wifi.keystore@1.0-service.rc"],
    vendor: true,
    visibility: ["//visibility:public"],
}