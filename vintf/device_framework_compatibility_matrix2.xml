    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.somc.hardware.radio</name>
        <version>1.0</version>
        <interface>
            <name>ISomcHook</name>
            <instance>somchook</instance>
            <instance>somchook2</instance>
        </interface>
    </hal>
    <!-- Add Vendor Fingerprint HAL -->
    <hal format="aidl" optional="true">
        <name>vendor.hardware.biometrics.fingerprintRbs</name>
        <version>1</version> <!-- Assuming version 1, verify if possible -->
        <interface>
            <name>IFingerprintRbs</name>
            <instance>Rbs</instance> <!-- Assuming instance Rbs, verify if possible -->
        </interface>
    </hal>
</compatibility-matrix> 