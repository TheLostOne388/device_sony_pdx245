// device/sony/pdx245/dmctl/Android.bp
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// -----------------------------------------------------------------
// dmctl – statically linked, recovery-only
// -----------------------------------------------------------------
// Disabled: Using prebuilt dmctl from recovery/bin instead
/*
cc_binary {
    name: "dmctl_recovery",
    stem: "dmctl",               // installed file name
    recovery: true,              // only build for recovery
    static_executable: true,     // link EVERYTHING static
    // -------------------------------------------------------------
    // Sources
    // -------------------------------------------------------------
    srcs: [
        // upstream file lives in system/core; pull it in via relative path
        "//system/core/fs_mgr/tools/dmctl.cpp",
    ],

    // -------------------------------------------------------------
    // Static libraries – FULL transitive closure for recovery
