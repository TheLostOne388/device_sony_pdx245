    // -------------------------------------------------------------
    static_libs: [
        // primary fs_mgr stack
        "libdm",                 // device-mapper C++ wrapper
        "liblp",                 // logical-partition metadata
        "libfs_mgr",             // fs_mgr helpers
        // crypto / verity
        "libcrypto_static",      // Use static variant for recovery
        "libcrypto_static_dispatch",
        "libavb",
        // file-system & hashing utilities
        "libext4_utils",
        "libfec",
        "libfec_rs",
        "libfscrypt",
        "libz",                  // zlib
        "libbase",               // android-base
        "liblog",
        "libselinux",
        "libsparse",
        "libkeyutils",
        // Additional recovery dependencies
        "libc++_static",
        "libc",
        "libm",
        "libdl_static",
    ],

    // -------------------------------------------------------------
    // Build flags
    // -------------------------------------------------------------
    cppflags: [
        "-D_FILE_OFFSET_BITS=64",
        "-Werror",
    ],
    ldflags: [
        "-Wl,--fatal-warnings",
        // shrink binary a little; optional
        "-Wl,-s",
    ],

    // -------------------------------------------------------------
    // Exclude any dynamic pieces that sneak in via libavb / libcrypto
    // -------------------------------------------------------------
    stl: "none",                 // avoid pulling in libc++_shared
    strip: {
        all: true,
    },

    // -------------------------------------------------------------
    // Visibility: make it available only to recovery image
    // -------------------------------------------------------------
    visibility: [":__subpackages__"],
}
