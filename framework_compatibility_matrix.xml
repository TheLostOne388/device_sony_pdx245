<?xml version="1.0" encoding="UTF-8"?>
<\!-- 
    This defines FCM compatibility for the Sony Xperia 10 V (PDX245)
    framework_compatibility_matrix.xml
-->
<compatibility-matrix version="5.0" type="framework">
    <\!-- Sony-specific HALs -->
    <hal format="hidl" optional="true">
        <n>vendor.semc.hardware.display</n>
        <version>2.5</version>
        <interface>
            <n>IDisplay</n>
            <instance>default</instance>
        </interface>
        <interface>
            <n>IFramerateController</n>
            <instance>default</instance>
        </interface>
    </hal>

    <\!-- These FCM level definitions are required for proper compatibility -->
    <vendor-ndk>
        <version>34</version>
    </vendor-ndk>
    <system-sdk>
        <version>34</version>
    </system-sdk>
    <vndk>
        <version>34</version>
    </vndk>
    
    <\!-- Specify kernel level -->
    <kernel version="6.1.0" level="8"/>
</compatibility-matrix>
